# === Mode ===
# When true (or when required API keys below are missing), the app runs with
# deterministic mock providers instead of live external services. Mock sources
# are always clearly labelled as such (source_tier=MOCK) and are never
# presented as real SEC/web/API data.
DEMO_MODE=true

# === LLM Provider ===
# One of: groq, openai
LLM_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Groq: OpenAI-compatible API, free tier available at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
# Optional: paces LLM calls to stay under this tokens-per-minute budget
# instead of firing them as fast as possible and hitting 429s. Leave unset
# for a paid/high-limit account. Groq's free tier measured as low as 8000
# TPM depending on the underlying model - set comfortably below that.
LLM_TPM_LIMIT=

# === Web Search Provider ===
# One of: tavily, serpapi
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=

# === Financial Data Providers ===
# SEC EDGAR requires a descriptive User-Agent per SEC fair-access policy.
SEC_EDGAR_USER_AGENT="Financial Research Agent OJT Project contact@example.com"
ALPHAVANTAGE_API_KEY=

# === Storage ===
# PostgreSQL (with pgvector) is the primary database. Locally it runs in
# Docker: `docker compose up -d db` (host port 5434). When deploying, point
# this at your hosted Postgres (Neon / Supabase) - nothing else changes.
DATABASE_URL=postgresql+psycopg://verifi:verifi_local_dev@localhost:5434/verifi
# Offline fallback without Docker (single-user only):
# DATABASE_URL=sqlite:///./data/financial_research_agent.db
POSTGRES_DB=verifi
POSTGRES_USER=verifi
POSTGRES_PASSWORD=verifi_local_dev
POSTGRES_PORT=5434

# How old a company's stored filings may get before the database re-checks
# the source API for new ones (served from the database meanwhile).
FILINGS_SYNC_HOURS=12

# === Agent loop limits ===
# MAX_FOLLOWUP_ITERATIONS: each extra iteration re-runs retrieval +
# extraction + verification, roughly doubling wall-clock time per
# iteration. On a rate-limited free LLM tier that dominates latency, so 0
# (skip follow-up research) is a reasonable setting there; raise it to 1-2
# when running against a provider with headroom.
MAX_FOLLOWUP_ITERATIONS=2
MAX_RESEARCH_QUERIES=12
MAX_SUBQUERIES_PER_PLAN=6

# === Auth ===
# Session lifetimes; set SESSION_COOKIE_SECURE=true when served over HTTPS.
USER_SESSION_DAYS=7
DEMO_SESSION_HOURS=2
SESSION_COOKIE_SECURE=false

# Must match this server's actual URL exactly (scheme+host+port) - used to
# build the Google OAuth redirect URI and the link sent in magic-link
# emails. Change this when deploying.
APP_BASE_URL=http://localhost:8000

# Sign in with Google. Leave both unset to hide the Google button entirely.
# Create a Web application OAuth client at https://console.cloud.google.com/
# > APIs & Services > Credentials, and add
# {APP_BASE_URL}/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email sign-in via Resend (https://resend.com - free tier, no
# card required). Leave unset to hide the "email me a link" option.
# RESEND_FROM_EMAIL's default (onboarding@resend.dev) needs no domain setup;
# switch it to your own verified domain once you have one.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VeriFi <onboarding@resend.dev>

# Separate-frontend deployments only (see DEPLOYMENT.md, Option B). Leave
# empty when this server serves the frontend itself (the default).
CORS_ORIGINS=
FRONTEND_URL=
SESSION_COOKIE_SAMESITE=lax

# Local embedding model for RAG (~700 MB RAM). Set false on small instances;
# long documents then fall back to prefix truncation.
RAG_ENABLED=true

# === App ===
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
