# Leave empty for the default deployment, where the backend serves this
# frontend from the same origin (and for local dev, where Vite proxies /api).
#
# Set it only when hosting the frontend separately (e.g. a Render Static
# Site), to the backend's public origin with no trailing slash:
#   VITE_API_BASE_URL=https://verifi-api.onrender.com
#
# Every VITE_ variable is compiled into the public JavaScript bundle - never
# put an API key or any other secret here.
VITE_API_BASE_URL=
